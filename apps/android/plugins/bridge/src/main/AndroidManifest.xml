<?xml version="1.0" encoding="utf-8"?>
<!--
  ClipMesh Android plugin manifest.

  Merged into the application manifest at build time, which is why the plugin
  can declare its own permissions and components instead of asking the
  generated project to.

  - FOREGROUND_SERVICE + FOREGROUND_SERVICE_DATA_SYNC: keep the sync engine
    alive while the app is in the background. Android 14 requires the specific
    type, not just the generic permission.
  - POST_NOTIFICATIONS: Android 13 and later need this to show anything at all,
    including the foreground service notification.
  - RECEIVE_BOOT_COMPLETED: restart the service after a reboot so a paired
    desktop can keep syncing without the user opening the app.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <service
            android:name="app.cm.clipmesh.bridge.foregroundservice.ClipMeshService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name="app.cm.clipmesh.bridge.foregroundservice.ClipboardActionReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name="app.cm.clipmesh.bridge.foregroundservice.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
          The "broadcast clipboard" notification action lands here.

          - `Theme.Translucent.NoTitleBar` shows nothing while the window holds
            the focus Android demands before it hands over the clipboard. It is
            deliberately *not* a Dialog/floating theme: floating windows are not
            focusable by default, and a window without focus cannot read the
            clipboard, which would make the whole activity pointless.
          - its own task affinity, plus `excludeFromRecents` and `noHistory`, so
            it never joins the app's task, never shows up in the recents list,
            and cannot be left behind invisible.
          - `exported="false"`: only our own notification's PendingIntent may
            start it, and it reads the clipboard.
        -->
        <activity
            android:name="app.cm.clipmesh.bridge.broadcast.BroadcastActivity"
            android:enabled="true"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:taskAffinity="app.cm.clipmesh.broadcast"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:finishOnTaskLaunch="true"
            android:allowTaskReparenting="false" />
    </application>
</manifest>
