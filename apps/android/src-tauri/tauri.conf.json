{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipMesh",
  "version": "1.0.0",
  "identifier": "app.cm.clipmesh",
  "build": {
    "beforeDevCommand": "npm --prefix ui run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm --prefix ui run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ClipMesh",
        "width": 420,
        "height": 860,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Secure peer-to-peer clipboard sync",
    "longDescription": "ClipMesh synchronises your clipboard between your own devices over the local network, encrypted end to end with no server in the middle.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
